  "item": [
    {
      "name": "Get Current Weather for Kochi",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let jsonData=pm.response.json();\r",
              "\r",
              "pm.test(\"Check city is Kochi & Country is India\",function(){\r",
              "    pm.expect(jsonData.name).to.eql(\"Kochi\");\r",
              "    pm.expect(jsonData.sys.country).to.eql(\"IN\");\r",
              "});\r",
              "\r",
              "pm.test(\"check respponse time\",function(){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/weather?q=Kochi&appid={{apiKey}}&{{units}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "weather"
          ],
          "query": [
            {
              "key": "q",
              "value": "Kochi"
            },
            {
              "key": "appid",
              "value": "{{apiKey}}"
            },
            {
              "key": "{{units}}",
              "value": null
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get 5-Day Forecast for Kochi",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let jsonData=pm.response.json();\r",
              "\r",
              "pm.test(\"Checking 40 data points\", function(){\r",
              "    pm.expect(jsonData.list).to.be.an('array');\r",
              "    pm.expect(jsonData.cnt).to.equal(40);\r",
              "})\r",
              "\r",
              "pm.test(\"Verify forecast items contain valid weather arrays\", function () {\r",
              "    \r",
              "    pm.expect(jsonData.list[0].weather[0].main).to.be.a('string');\r",
              "});\r",
              "\r",
              ""
